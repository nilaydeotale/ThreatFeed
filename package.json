{
  "name": "threatfeed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" --write",
    "prepare": "husky",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "world-map": "tsx scripts/build-world-map.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "lucide-react": "^1.64.0",
    "minisearch": "^7.1.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
